FROM node:22-alpine
WORKDIR /app

# Only used to build+serve a preview; e2e browsers aren't needed here and
# are slow/unreliable to fetch in a container build.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

EXPOSE 4173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]
